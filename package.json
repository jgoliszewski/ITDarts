{
  "name": "itdarts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Office darts on an Autodarts board: game rules, match state and scoreboard.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"tsx watch server/index.ts\" \"vite\"",
    "dev:fake": "concurrently -k -n board,wled,server,web -c magenta,green,yellow,cyan \"tsx server/fake-board.ts\" \"tsx server/fake-wled.ts\" \"tsx watch server/index.ts --board localhost:3180\" \"vite\"",
    "fake-board": "tsx server/fake-board.ts",
    "fake-wled": "tsx server/fake-wled.ts",
    "led-lab": "tsx server/led-lab/index.ts",
    "led-lab:upload": "tsx server/led-lab/upload.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "kiosk": "vite build && tsx server/index.ts --kiosk",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "fastify": "^5.12.7",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
